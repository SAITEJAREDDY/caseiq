# ── Groq API ──────────────────────────────────────────────────────────────────
# Get your key at: console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here

# ── LangSmith (observability) ─────────────────────────────────────────────────
# Get your key at: smith.langchain.com → Settings → API Keys
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=support-intelligence-poc

# ── Neo4j AuraDB ──────────────────────────────────────────────────────────────
# Create a free instance at: console.neo4j.io
# URI format: neo4j+s://<xxxxx>.databases.neo4j.io
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_aura_password_here

# ── Neo4j AuraDB #2 -- Phase 4 runtime graph (data/raw_v2+phase2+phase3) ───────
# A SEPARATE instance from the one above -- Phase 1 reuses Phase 0's exact
# product/case id scheme, so loading both datasets into the same database
# would corrupt the live app's graph. Create a second free instance at
# console.neo4j.io. Optional: only agent/graph_v2/*.py reads these.
NEO4J_V2_URI=neo4j+s://your-second-instance.databases.neo4j.io
NEO4J_V2_USERNAME=neo4j
NEO4J_V2_PASSWORD=your_second_aura_password_here

# ── Together AI ───────────────────────────────────────────────────────────────
# Get your key at: api.together.ai → Settings → API Keys
# Used by the offline research code, never by the live app: Phase 1-3 narrative generation
# (data/generators*), the Phase 5 and Phase 9A diagnostic agents (Llama-3.3-70B-Instruct-Turbo),
# and the Phase 7/8 LLM baseline judge.
TOGETHER_API_KEY=

# ── Jev (TypeSafe AI) ─────────────────────────────────────────────────────────
# Used by the Phase 7/8 evaluations and the Phase 9 runtime verifier, through the direct-HTTP client in
# agent/jev_v2/client.py. Do NOT install the `typesafe-sdk` package: it upgrades tenacity past the <9 pin
# that langchain 0.2.16 and streamlit 1.35 need.
TYPESAFE_API_KEY=
